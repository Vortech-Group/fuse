{
    "name": "vortech/laravel-fuse",
    "description": "Track and enforce temporary code and technical debt in Laravel applications.",
    "keywords": [
        "vortech",
        "fuse",
        "laravel",
        "technical-debt",
        "deprecation",
        "attributes",
        "static-analysis",
        "ci"
    ],
    "homepage": "https://github.com/Vortech-Group/fuse",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "nikic/php-parser": "^5.0",
        "symfony/finder": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\Fuse\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vortech\\Fuse\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortech\\Fuse\\FuseServiceProvider"
            ],
            "aliases": {
                "Fuse": "Vortech\\Fuse\\Facades\\Fuse"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
